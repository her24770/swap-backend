#!/bin/sh

# Crea, lista y restaura dumps PostgreSQL almacenados en un bucket privado de R2.
# Flujo de backup: pg_dump -> validación -> subida -> SHA-256 remoto -> manifiesto.
# Flujo de restore: descarga -> validación -> confirmación -> pg_restore destructivo.

set -eu

# Fallar antes de crear archivos o abrir conexiones si falta configuración crítica.
: "${POSTGRES_HOST:?POSTGRES_HOST es requerido}"
: "${POSTGRES_DB:?POSTGRES_DB es requerido}"
: "${POSTGRES_USER:?POSTGRES_USER es requerido}"
: "${POSTGRES_PASSWORD:?POSTGRES_PASSWORD es requerido}"
: "${BACKUP_R2_ACCOUNT_ID:?BACKUP_R2_ACCOUNT_ID es requerido}"
: "${BACKUP_R2_ACCESS_KEY_ID:?BACKUP_R2_ACCESS_KEY_ID es requerido}"
: "${BACKUP_R2_SECRET_ACCESS_KEY:?BACKUP_R2_SECRET_ACCESS_KEY es requerido}"
: "${BACKUP_R2_BUCKET_NAME:?BACKUP_R2_BUCKET_NAME es requerido}"

export PGPASSWORD="$POSTGRES_PASSWORD"
export RCLONE_CONFIG_R2_TYPE=s3
export RCLONE_CONFIG_R2_PROVIDER=Cloudflare
export RCLONE_CONFIG_R2_ACCESS_KEY_ID="$BACKUP_R2_ACCESS_KEY_ID"
export RCLONE_CONFIG_R2_SECRET_ACCESS_KEY="$BACKUP_R2_SECRET_ACCESS_KEY"
export RCLONE_CONFIG_R2_ENDPOINT="https://${BACKUP_R2_ACCOUNT_ID}.r2.cloudflarestorage.com"
export RCLONE_CONFIG_R2_ACL=private
# El bucket debe existir; evita CreateBucket para tokens limitados a objetos.
export RCLONE_CONFIG_R2_NO_CHECK_BUCKET=true

prefix="${BACKUP_R2_PREFIX:-postgresql}"
remote="r2:${BACKUP_R2_BUCKET_NAME}/${prefix#/}"

list() {
    rclone lsf "$remote" --include '*.dump'
}

backup() {
    keep_days="${BACKUP_KEEP_DAYS:-7}"
    case "$keep_days" in
        ''|*[!0-9]*) echo "[ERROR] BACKUP_KEEP_DAYS debe ser un entero." >&2; exit 1 ;;
    esac

    # Evita solapar una ejecución manual con la iniciada por cron.
    lock=/tmp/postgres-backup.lock
    mkdir "$lock" 2>/dev/null || {
        echo "[ERROR] Ya hay un backup en ejecución." >&2
        exit 1
    }

    # Variables de estado para el manifiesto JSON.
    started_epoch="$(date +%s)"
    started_at="$(date -u +'%Y-%m-%dT%H:%M:%SZ')"
    execution_id="$(date -u +'%Y%m%dT%H%M%SZ')"
    filename="${POSTGRES_DB}_${execution_id}.dump"
    manifest_filename="${filename}.manifest.json"
    tmp_dir="$(mktemp -d)"
    dump="$tmp_dir/$filename"
    manifest="$tmp_dir/$manifest_filename"
    size_bytes=0
    local_sha256=""
    remote_sha256=""
    dump_validated=false
    stage=pg_dump

    write_manifest() {
        status="$1"
        completed_at="$(date -u +'%Y-%m-%dT%H:%M:%SZ')"
        duration_seconds="$(($(date +%s) - started_epoch))"
        sha256_match=false
        [ -n "$local_sha256" ] && [ "$local_sha256" = "$remote_sha256" ] && sha256_match=true

        printf '{\n  "schema_version": 1,\n  "execution_id": "%s",\n  "status": "%s",\n  "stage": "%s",\n  "database": "%s",\n  "postgres_host": "%s",\n  "backup_file": "%s",\n  "size_bytes": %s,\n  "dump_validated": %s,\n  "sha256_local": "%s",\n  "sha256_r2": "%s",\n  "sha256_match": %s,\n  "started_at": "%s",\n  "completed_at": "%s",\n  "duration_seconds": %s,\n  "destination": "r2://%s/%s/%s"\n}\n' \
            "$execution_id" "$status" "$stage" "$POSTGRES_DB" "$POSTGRES_HOST" \
            "$filename" "$size_bytes" "$dump_validated" "$local_sha256" "$remote_sha256" \
            "$sha256_match" "$started_at" "$completed_at" "$duration_seconds" \
            "$BACKUP_R2_BUCKET_NAME" "${prefix#/}" "$filename" > "$manifest"
    }

    cleanup() {
        exit_code="$?"
        trap - EXIT INT TERM
        if [ "$exit_code" -ne 0 ]; then
            write_manifest failed
            echo "[Backup] Falló en etapa '$stage' (ejecución $execution_id)." >&2
            rclone copyto "$manifest" "$remote/$manifest_filename" >/dev/null 2>&1 || true
        fi
        rm -r "$tmp_dir"
        rmdir "$lock"
        exit "$exit_code"
    }
    trap cleanup EXIT
    trap 'exit 130' INT
    trap 'exit 143' TERM

    echo "[Backup] Generando $filename..."
    pg_dump \
        --host="$POSTGRES_HOST" \
        --port="${POSTGRES_PORT:-5432}" \
        --username="$POSTGRES_USER" \
        --dbname="$POSTGRES_DB" \
        --format=custom \
        --compress=9 \
        --no-owner \
        --no-acl \
        --file="$dump"

    # No subir un dump que pg_restore no pueda leer.
    stage=validate_dump
    pg_restore --list "$dump" >/dev/null
    dump_validated=true

    size_bytes="$(wc -c < "$dump" | tr -d ' ')"
    local_sha256="$(sha256sum "$dump" | awk '{print $1}')"

    stage=upload_dump
    rclone copyto "$dump" "$remote/$filename"

    # Releer el objeto completo detecta truncamiento o corrupción en el destino.
    stage=verify_remote_sha256
    remote_sha256="$(rclone cat "$remote/$filename" | sha256sum | awk '{print $1}')"
    if [ "$local_sha256" != "$remote_sha256" ]; then
        echo "[ERROR] SHA-256 remoto no coincide para $filename." >&2
        exit 1
    fi

    stage=completed
    write_manifest success
    rclone copyto "$manifest" "$remote/$manifest_filename"

    # La limpieza ocurre sólo después de confirmar una subida exitosa.
    stage=retention
    case "$keep_days" in
        0) ;;
        *)
            rclone delete "$remote" \
                --include '*.dump' \
                --include '*.manifest.json' \
                --min-age "${keep_days}d"
            ;;
    esac

    echo "[Backup] Completado y verificado: $remote/$filename"
    echo "[Backup] SHA-256: $local_sha256"
    echo "[Backup] Manifiesto: $remote/$manifest_filename"
}

restore() {
    # Sin argumento se usa el dump más reciente; los timestamps UTC ordenan por nombre.
    filename="${1:-$(list | sort | tail -n 1)}"
    if [ -z "$filename" ]; then
        echo "[ERROR] No hay backups en $remote." >&2
        exit 1
    fi

    # La confirmación explícita protege contra restaurar accidentalmente producción.
    printf "Restaurar '%s' sobre '%s'. Escribe el nombre de la base para confirmar: " "$filename" "$POSTGRES_DB"
    read -r confirmation
    if [ "$confirmation" != "$POSTGRES_DB" ]; then
        echo "[CANCELADO] La confirmación no coincide." >&2
        exit 1
    fi

    tmp_dir="$(mktemp -d)"
    trap 'rm -r "$tmp_dir"' EXIT INT TERM
    dump="$tmp_dir/restore.dump"

    rclone copyto "$remote/$filename" "$dump"
    pg_restore --list "$dump" >/dev/null
    # --clean reemplaza los objetos actuales; la base destino debe existir.
    pg_restore \
        --host="$POSTGRES_HOST" \
        --port="${POSTGRES_PORT:-5432}" \
        --username="$POSTGRES_USER" \
        --dbname="$POSTGRES_DB" \
        --clean \
        --if-exists \
        --exit-on-error \
        --no-owner \
        --no-acl \
        "$dump"

    echo "[Restore] Completado sobre '$POSTGRES_DB'."
}

case "${1:-}" in
    backup) backup ;;
    list) list ;;
    restore) restore "${2:-}" ;;
    *) echo "Uso: postgres-backup {backup|list|restore [archivo.dump]}" >&2; exit 1 ;;
esac
