# Variables de STAGING (SWAP-673). Copiar a swap-staging/swap-backend/.env.staging
# en el servidor, con chmod 600. NUNCA copiar los valores de producción: staging
# usa llaves, contraseñas y buckets propios, y datos de prueba.
NODE_ENV=production
PORT=3001
TRUST_PROXY=cloudflare
# Obligatorio y debe contener "swap-staging": deploy-staging.sh lo exige.
FRONTEND_URL=https://swap-staging.jhgo.online

# Generar cada secreto con: openssl rand -base64 32
JWT_SECRET=cambiar
JWT_EXPIRACION=8h
POSTGRES_USER=swap_staging
POSTGRES_PASSWORD=cambiar
POSTGRES_DB=swap_staging
REDIS_PASSWORD=cambiar
REDIS_CONNECT_TIMEOUT_MS=5000

# Servicios externos: usar cuentas/llaves de PRUEBA, distintas a las de producción
# (Resend con un dominio o destinatarios de prueba; un bucket R2 propio).
RESEND_API_KEY=cambiar
RESEND_FROM=Swap Staging <staging@jhgo.online>
OPENAI_API_KEY=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
MODERATION_UMBRAL=0.5

# Alertas de staging a un canal distinto al de producción (o vacío para desactivarlas).
SECURITY_ALERT_WEBHOOK_URL=
