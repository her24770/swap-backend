NODE_ENV=test
RUN_INTEGRATION=true
JWT_SECRET=integration-only-secret
DATABASE_URL=postgresql://swap_test:swap_test@localhost:55432/swap_integration_test?schema=public
REDIS_URL=redis://localhost:56379/15
FRONTEND_URL=http://localhost:3000

# Los tests actuales no llaman servicios externos. Estos valores evitan usar
# credenciales reales si se importa el cliente R2 durante una prueba.
CLOUDFLARE_R2_ACCOUNT_ID=integration-placeholder
CLOUDFLARE_R2_ACCESS_KEY_ID=integration-placeholder
CLOUDFLARE_R2_SECRET_ACCESS_KEY=integration-placeholder
CLOUDFLARE_R2_BUCKET_NAME=integration-placeholder
CLOUDFLARE_R2_PUBLIC_URL=https://integration.invalid
