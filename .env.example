# ─── App ───────────────────────────────────────
NODE_ENV=production
PORT=3001
JWT_SECRET=change_me_to_a_long_random_secret
JWT_EXPIRACION=8h  

# ─── PostgreSQL ────────────────────────────────
# Obligatorio: docker-compose falla al arrancar si no se define. NO usar estos valores en producción.
POSTGRES_USER=admin
POSTGRES_PASSWORD=change_me_to_a_long_random_secret
POSTGRES_DB=appdb

# Prisma usa esta variable directamente (debe coincidir con USER/PASSWORD/DB de arriba)
DATABASE_URL=postgresql://admin:change_me_to_a_long_random_secret@postgres:5432/appdb?schema=public

# ─── Redis ─────────────────────────────────────
# Obligatorio: docker-compose falla al arrancar si no se define. NO usar este valor en producción.
REDIS_PASSWORD=change_me_to_a_long_random_secret
REDIS_URL=redis://:change_me_to_a_long_random_secret@redis:6379

# ─── Frontend Port ─────────────────────────────────────
FRONTEND_URL=http://localhost:3000

# ─── Embeddings ────────────────────────────────
EMBEDDINGS_SERVICE_URL=http://embeddings:8000

# ─── Moderación de contenido ───────────────────
OPENAI_API_KEY=sk-...
MODERATION_UMBRAL=0.5

# ─── AWS Rekognition (moderación de imágenes) ──
AWS_ACCESS_KEY_ID=your_access_key_id
AWS_SECRET_ACCESS_KEY=your_secret_access_key
AWS_REGION=us-east-1
MODERATION_UMBRAL_EXPLICIT_NUDITY=50
MODERATION_UMBRAL_NON_EXPLICIT_NUDITY=80
MODERATION_UMBRAL_VIOLENCE=70
MODERATION_UMBRAL_DRUGS=90
MODERATION_UMBRAL_HATE_SYMBOLS=70
MODERATION_UMBRAL_VISUALLY_DISTURBING=60

# ─── Cloudflare R2 ─────────────────────────────
CLOUDFLARE_R2_ACCOUNT_ID=your_account_id
CLOUDFLARE_R2_ACCESS_KEY_ID=your_access_key_id
CLOUDFLARE_R2_SECRET_ACCESS_KEY=your_secret_access_key
CLOUDFLARE_R2_BUCKET_NAME=your_bucket_name
CLOUDFLARE_R2_PUBLIC_URL=https://pub-xxxxxxxxxxxxxxxxxxxxxxxxxxxx.r2.dev

# ─── Validación correo ─────────────────────────
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxx
RESEND_FROM="SWAP <noreply@swap.jhgo.online>"