# ─── App ───────────────────────────────────────
NODE_ENV=production
PORT=3001
JWT_SECRET=change_me_to_a_long_random_secret
JWT_EXPIRACION=8h  

# ─── PostgreSQL ────────────────────────────────
POSTGRES_USER=admin
POSTGRES_PASSWORD=secret
POSTGRES_DB=appdb

# Prisma usa esta variable directamente
DATABASE_URL=postgresql://admin:secret@postgres:5432/appdb?schema=public

# ─── Redis ─────────────────────────────────────
REDIS_PASSWORD=redissecret
REDIS_URL=redis://:redissecret@redis:6379 

# ─── Frontend Port ─────────────────────────────────────
FRONTEND_URL=http://localhost:3000

# ─── Embeddings ────────────────────────────────
EMBEDDINGS_SERVICE_URL=http://embeddings:8000

# ─── Moderación de contenido ───────────────────
OPENAI_API_KEY=sk-...
MODERATION_UMBRAL=0.5

# ─── AWS Rekognition (moderación de imágenes) ──
AWS_ACCESS_KEY_ID=your_access_key_id
AWS_SECRET_ACCESS_KEY=your_secret_access_key
AWS_REGION=us-east-1
MODERATION_UMBRAL_EXPLICIT_NUDITY=50
MODERATION_UMBRAL_NON_EXPLICIT_NUDITY=80
MODERATION_UMBRAL_VIOLENCE=70
MODERATION_UMBRAL_DRUGS=90
MODERATION_UMBRAL_HATE_SYMBOLS=70
MODERATION_UMBRAL_VISUALLY_DISTURBING=60

# ─── Cloudflare R2 ─────────────────────────────
CLOUDFLARE_R2_ACCOUNT_ID=your_account_id
CLOUDFLARE_R2_ACCESS_KEY_ID=your_access_key_id
CLOUDFLARE_R2_SECRET_ACCESS_KEY=your_secret_access_key
CLOUDFLARE_R2_BUCKET_NAME=your_bucket_name
CLOUDFLARE_R2_PUBLIC_URL=https://pub-xxxxxxxxxxxxxxxxxxxxxxxxxxxx.r2.dev

# ─── Validación correo ─────────────────────────
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxx
RESEND_FROM="SWAP <noreply@swap.jhgo.online>"